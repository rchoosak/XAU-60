# MetaTrader 5 account
MT5_MODE=auto
MT5_LOGIN=your_account_number
MT5_PASSWORD=your_password
MT5_SERVER=YourBroker-Demo
MT5_PATH=
MT5_TIMEOUT=60000

# Enable this on macOS/Linux when using the MT5 EA bridge.
MT5_BRIDGE_ENABLED=false
MT5_BRIDGE_HOST=0.0.0.0
MT5_BRIDGE_PORT=8765
MT5_BRIDGE_TOKEN=change-me
MT5_BRIDGE_TIMEOUT=30000
MT5_BRIDGE_POLL_TIMEOUT=25000

# Telegram alerts
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord alerts
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=

# Risk management
MAX_RISK_PER_TRADE=2.0
MAX_DAILY_LOSS=5.0
MAX_DRAWDOWN=20.0
MAX_POSITIONS=5
MAX_POSITIONS_PER_SYMBOL=2

# Trading defaults
DEFAULT_LOT_SIZE=0.01
DEFAULT_MAGIC_NUMBER=123456
SLIPPAGE=10
CHECK_INTERVAL=1

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/trading_bot.log
LOG_ROTATION=10 MB
LOG_RETENTION=7 days

# UI
UI_REFRESH_RATE=5
UI_THEME=light
